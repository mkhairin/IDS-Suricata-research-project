# [SKENARIO 4] SQL INJECTION (SQLMAP)
# Rule 1A: Spesifik menangkap UNION/SELECT
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"[TA-SIG::S04-SQLI-UNION] SQL Injection - Obfuscated UNION/SELECT Injection in URI (High Confidence)"; flow:established,to_server; http.uri; content:"select"; nocase; fast_pattern; content:"="; pcre:"/(?i)(union(?:\s|\/\*.*?\*\/)+select|select(?:\s|\/\*.*?\*\/)+from)/U";  threshold:type both, track by_src, count 3, seconds 10; reference:url,owasp.org/www-community/attacks/SQL_Injection; classtype:web-application-attack; sid:1026041; rev:5; metadata: author Muhammad_Khairin, created_at 2026_04_07, project Tugas_Akhir_Optimasi_IDS;)

# Rule 1B: Spesifik menangkap Logical AND/OR (Merespons Tamper between)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"[TA-SIG::S04-SQLI-LOGIC]SQL Injection - Boolean-Based Injection in URI (Tamper Detected) (High Confidence)"; flow:established,to_server; http.uri; content:"and"; nocase; fast_pattern; content:"="; pcre:"/(?i)\b(and|or)\b[\s\/\*\(\)]+(?:\d+|'[^']*'|@@\w+|[a-zA-Z_]+\()[\s\/\*\(\)]*(?:=|like|between|in|>|<)/U"; threshold:type both, track by_src, count 3, seconds 10; reference:url,owasp.org/www-community/attacks/SQL_Injection; classtype:web-application-attack; sid:1026044; rev:5; metadata: attack_type SQL_Injection, mitre_tactic Credential_Access, author Muhammad_Khairin, project Tugas_Akhir_Optimasi_IDS;)

# 2. Rule Time-Based Blind (Memperbaiki Buffer Buta)
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"[TA-SIG::S04-SQLI-TIME] SQL Injection - Time-Based Blind Injection Detected (High Confidence)"; flow:established,to_server; http.uri; content:"sleep"; nocase; content:"("; distance:0; within:6; fast_pattern; pcre:"/(?i)(sleep[\s\/\*]*\(\s*\d+\s*\)|pg_sleep\s*\(|benchmark\s*\()/U";  threshold:type both, track by_src, count 2, seconds 20; reference:url,owasp.org/www-community/attacks/Blind_SQL_Injection; classtype:web-application-attack; sid:1026042; rev:5; metadata: author Muhammad_Khairin, created_at 2026_04_07, project Tugas_Akhir_Optimasi_IDS;)

# 3. Rule Header & Cookie Injection
alert http any any -> $HOME_NET $HTTP_PORTS (msg:"[TA-SIG::S04-SQLI-HEADER] SQL Injection - Blind Injection in HTTP Header / Cookie (High Confidence)"; flow:established,to_server; http.uri; content:"select"; nocase; fast_pattern; pcre:"/(?i)(sleep[\s\/\*]*\(\s*\d+|benchmark[\s\/\*]*\(\s*\d+|waitfor\s+delay|extractvalue[\s\/\*]*\(|updatexml[\s\/\*]*\(|union(?:\s|\/\*.*?\*\/)+select)/U"; threshold:type both, track by_src, count 2, seconds 20; classtype:web-application-attack; sid:1026043; rev:5; metadata: attack_type SQL_Injection, mitre_tactic Credential_Access, author Muhammad_Khairin, project Tugas_Akhir_Optimasi_IDS;)
